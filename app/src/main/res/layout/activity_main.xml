<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/app_root"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        android:background="?attr/colorSurface" />
    <FrameLayout android:id="@+id/site_container"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <WebView android:id="@+id/site_webview"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <ProgressBar android:id="@+id/site_progress"
            style="?android:attr/progressBarStyleLarge"
            android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_gravity="center" />
        <LinearLayout android:id="@+id/site_renderer_error"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="center" android:orientation="vertical"
            android:padding="24dp" android:gravity="center"
            android:visibility="gone">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/renderer_error_title" android:textAppearance="?android:attr/textAppearanceLarge"
                android:gravity="center" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="12dp" android:text="@string/renderer_error_message"
                android:gravity="center" />
            <Button android:id="@+id/reload_site"
                android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:layout_marginTop="16dp" android:text="@string/reload_site" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
